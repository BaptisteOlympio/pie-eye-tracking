{
  // Name of the container, 
  "name": "openface-service DevContainer",

  // Location of the build
  "build": {
    "dockerfile": "../../openface-service/Dockerfile"
  },

  // I use /app here because the application is created in /app (cf Dockerfile)
  // I am using uv that create a .venv in /app, so I am using the same one
  "workspaceFolder": "/app",
  "mounts": [
    "source=${localWorkspaceFolder}/openface-service,target=/app,type=bind"
  ],
  "appPort": [
    "8081:8081"
  ],
  "customizations": {
    "vscode": {
      "settings": {},
      "extensions": [
        "ms-python.vscode-pylance",
        "ms-azuretools.vscode-docker",
        "sankethdev.vscode-proto"
      ]
    }
  }
}