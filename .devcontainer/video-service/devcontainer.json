{
  // Name of the dev container
  "name": "Video Service DevContainer",
  // Location of the build
  "build": {
    "dockerfile": "../../video-service/Dockerfile"
  },
  // I use /app here because the application is created in /app (cf Dockerfile)
  // I am using uv that create a .venv in /app, so I am using the same one
  "workspaceFolder": "/app",
  "mounts": [
    "source=${localWorkspaceFolder}/video-service,target=/app,type=bind"
  ],
  "appPort": [
    "8080:8080"
  ],
  "customizations": {
    "vscode": {
      "settings": {},
      "extensions": [
        "ms-python.vscode-pylance",
        "ms-azuretools.vscode-docker"
      ]
    }
  }
}