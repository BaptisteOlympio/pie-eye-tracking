{
  // Name of the dev container, 
  "name": "Decision Service DevContainer",
  // Location of the docker compose file with overwrite
  "dockerComposeFile": [
    "../../docker-compose.yaml",
    "./docker-compose.devcontainer.yaml"
  ],
  // Name of the service to run
  "service": "decision-service",
  "workspaceFolder": "/app",
  "mounts": [
    "source=${localWorkspaceFolder}/decision-service,target=/app,type=bind"
  ],
  "runServices": [
    "openface-service"
  ],
  "customizations": {
    "vscode": {
      "settings": {},
      "extensions": [
        "ms-python.vscode-pylance",
        "ms-azuretools.vscode-docker",
        "firefox-devtools.vscode-firefox-debug"
      ]
    }
  },
  "updateRemoteUserUID": true
}